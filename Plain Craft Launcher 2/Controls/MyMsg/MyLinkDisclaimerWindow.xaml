<Window x:Class="MyLinkDisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于内置联机功能的特别声明与免责条款"
        Width="660" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F7F7F7"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720">
        <StackPanel Margin="24">
            <TextBlock Text="关于内置联机功能的特别声明与免责条款" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#555555"
                       Text="本启动器提供的内置联机功能（包括但不限于 P2P 直连、内网穿透或集成的第三方联机服务）仅作为便利工具提供，其底层技术或网络链路依赖于外部第三方服务。在使用该功能前，请您务必知悉并同意以下事项：" />
            <CheckBox x:Name="CheckAvailability" Margin="0,16,0,0" VerticalContentAlignment="Top">
                <TextBlock TextWrapping="Wrap"
                           Text="1.服务可用性：开发者不保证该内置联机功能的绝对稳定性、低延迟或持续可用性。因第三方服务维护、网络波动或不可抗力导致的功能中断、连接失败或游戏存档损坏，开发者不承担任何责任。" />
            </CheckBox>
            <CheckBox x:Name="CheckPrivacy" Margin="0,12,0,0" VerticalContentAlignment="Top">
                <TextBlock TextWrapping="Wrap"
                           Text="2.隐私与数据安全：在建立联机连接的过程中，您的部分网络数据（包括但不限于真实 IP 地址、设备标识符或游戏内通信内容）可能会经过第三方节点。您需自行评估并承担潜在的数据泄露、中间人攻击或隐私暴露风险。" />
            </CheckBox>
            <CheckBox x:Name="CheckLoss" Margin="0,12,0,0" VerticalContentAlignment="Top">
                <TextBlock TextWrapping="Wrap"
                           Text="3.风险警告：因使用、滥用或无法使用该内置联机功能而引发的任何直接或间接损失（包括账号异常、虚拟财产损失或与其他玩家的纠纷），均由用户自行承担全部法律与经济责任，启动器开发者及关联方对此不承担任何赔偿或连带责任。" />
            </CheckBox>
            <CheckBox x:Name="CheckChangeRight" Margin="0,12,0,0" VerticalContentAlignment="Top">
                <TextBlock TextWrapping="Wrap"
                           Text="4.功能变更权：开发者保留在不预先通知的情况下，随时修改、限制或永久终止该内置联机功能的权利。" />
            </CheckBox>
            <CheckBox x:Name="CheckLaw" Margin="0,12,0,0" VerticalContentAlignment="Top">
                <TextBlock TextWrapping="Wrap"
                           Text="5.在联机功能时，我将严格遵守我所在国家或地区的所有适用法律法规（包括但不限于网络安全、知识产权及未成年人保护相关法律），并对自身的网络行为承担全部法律责任。" />
            </CheckBox>
            <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnDecline" Content="退出联机" MinWidth="88" Height="30" Margin="0,0,10,0" IsCancel="True" />
                <Button x:Name="BtnAccept" Content="同意并继续" MinWidth="96" Height="30" IsDefault="True" IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
