<Window x:Class="MyChinaConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用前确认"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F7F7F7"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel Margin="24">
        <TextBlock Text="使用前确认" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#555555"
                   Text="本软件为 PCL 的第三方修改版本，与 Mojang Studios 及 PCL 官方无关。&#xa;&#xa;请确认以下两项后继续使用。若不同意，请退出本软件。" />
        <CheckBox x:Name="CheckAge" Margin="0,20,0,0" Content="我已年满 22 周岁" />
        <CheckBox x:Name="CheckEula" Margin="0,12,0,0" Content="我已阅读并同意 Minecraft 最终用户许可协议（EULA）" />
        <TextBlock Margin="24,6,0,0" FontSize="12">
            <Hyperlink x:Name="LinkEula" RequestNavigate="LinkEula_RequestNavigate">查看 Minecraft EULA</Hyperlink>
        </TextBlock>
        <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnExit" Content="退出 PCL" MinWidth="88" Height="30" Margin="0,0,10,0" IsCancel="True" />
            <Button x:Name="BtnContinue" Content="同意并继续" MinWidth="96" Height="30" IsDefault="True" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
