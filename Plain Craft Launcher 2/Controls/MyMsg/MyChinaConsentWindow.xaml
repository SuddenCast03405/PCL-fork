<Window x:Class="MyChinaConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="clr-namespace:PCL"
        Title="使用前确认"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="#FBFBFB"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border BorderBrush="#22000000" BorderThickness="1">
        <Grid Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="使用前确认" FontSize="23" Foreground="{DynamicResource ColorBrush2}" />
            <Rectangle Grid.Row="1" Height="2" Fill="{DynamicResource ColorBrush2}" />
            <TextBlock Grid.Row="3" FontSize="15" LineHeight="22" TextWrapping="Wrap" Foreground="#FF5C5C5C"
                       Text="本软件为 PCL 的第三方修改版本，与 Mojang Studios 及 PCL 官方无关。&#xa;&#xa;根据你所在地区的要求，使用本软件前需要确认：你已年满 22 周岁，并已阅读、理解并同意 Minecraft 最终用户许可协议（EULA）。若你不同意，请退出本软件。" />
            <my:MyCheckBox Grid.Row="5" x:Name="CheckConsent" Text="我已年满 22 周岁，并同意 Minecraft EULA。" />
            <TextBlock Grid.Row="7" FontSize="13" Foreground="#FF5C5C5C">
                <Hyperlink x:Name="LinkEula" RequestNavigate="LinkEula_RequestNavigate"
                           Foreground="{DynamicResource ColorBrush3}">查看 Minecraft 最终用户许可协议（EULA）</Hyperlink>
            </TextBlock>
            <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
                <my:MyButton x:Name="BtnExit" Text="退出 PCL" ColorType="Normal" Margin="0,0,12,0" Padding="12,7" />
                <my:MyButton x:Name="BtnContinue" Text="同意并继续" ColorType="Highlight" IsEnabled="False" Padding="12,7" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
